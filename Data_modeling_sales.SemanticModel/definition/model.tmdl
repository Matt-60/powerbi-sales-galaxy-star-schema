model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_parameters

	annotation PBI_QueryGroupOrder = 2

queryGroup 01_bronze

	annotation PBI_QueryGroupOrder = 0

queryGroup 02_gold

	annotation PBI_QueryGroupOrder = 1

queryGroup 02_gold\dims

	annotation PBI_QueryGroupOrder = 0

queryGroup 02_gold\facts

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SourceFile","Address","CAMPAIGN_LOG","campaign_skus","cities","CUST_MASTER","customer_contacts","exchange_rates","inventory","invoice_lines","INVOICES","order_line_items","ORDERS_2025","ORDERS_2026","payments","products","regions","sales_targets","security","shipments","subcategories","user_details","fact_inventory","dim_customer","dim_product","orders","channels","dim_order_flags","fact_sales","dim_geo","fact_campaign_spend","dim_campaign","fact_promotion_coverage","fact_order_process","fact_sales_targets"]

annotation PBI_ProTooling = ["DevMode"]

ref table security
ref table dim_customer
ref table dim_product
ref table dim_order_flags
ref table fact_sales
ref table fact_inventory
ref table dim_geo
ref table fact_campaign_spend
ref table dim_campaign
ref table fact_promotion_coverage
ref table fact_order_process
ref table fact_sales_targets
ref table dim_date
ref table _measure
ref table Parameter

ref role 'Regional access'

ref cultureInfo en-US

